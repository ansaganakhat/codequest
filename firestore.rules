// CodeQuest AI — safe Firebase trial: users, students, classrooms and Live Quiz (no IIN or photos)
// Deploy with firebase deploy --only firestore:rules,firestore:indexes
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function myProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeParent() {
      return myProfileExists() &&
        myProfile().role == 'parent' &&
        myProfile().status != 'rejected';
    }
    function verifiedTeacherFor(student) {
      return myProfileExists() &&
        myProfile().role == 'teacher' &&
        request.auth.token.email_verified == true &&
        myProfile().status == 'approved' &&
        myProfile().school_id == student.school_id &&
        student.status == 'approved';
    }

    match /schools/{id} {
      allow get, list: if true; // Public catalogue is not sensitive.
      allow create, update, delete: if admin();
    }
    match /subjects/{id} {
      allow get, list: if true;
      allow create, update, delete: if admin();
    }
    match /users/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'id','last_name','first_name','middle_name','full_name','email','phone',
          'role','status','school_id','subject_ids','consented_at','created_at',
          'guardian_permission_acknowledged'
        ])
        && request.resource.data.keys().hasAll([
          'id','last_name','first_name','middle_name','full_name','email',
          'role','status','school_id','subject_ids','consented_at','created_at'
        ])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['teacher','parent','student']
        && request.resource.data.status == 'pending'
        && request.resource.data.last_name is string
        && request.resource.data.first_name is string
        && request.resource.data.middle_name is string
        && request.resource.data.full_name is string
        && request.resource.data.subject_ids is list
        && request.resource.data.consented_at is string
        && request.resource.data.created_at is string
        && (request.resource.data.role != 'teacher' ||
          (request.resource.data.school_id is int &&
           request.resource.data.subject_ids.size() > 0))
        && (request.resource.data.role != 'student' ||
          (request.resource.data.get('guardian_permission_acknowledged', false) == true
           && request.resource.data.school_id == null
           && request.resource.data.subject_ids.size() == 0));
      allow update, delete: if admin();
    }
    match /students/{childId} {
      allow get, list: if admin()
        || (signedIn() && resource.data.parent_id == request.auth.uid)
        || verifiedTeacherFor(resource.data);
      allow create: if activeParent()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'full_name','grade','class_letter','school_id','parent_id','status','created_at'
        ])
        && request.resource.data.keys().hasAll([
          'full_name','grade','class_letter','school_id','parent_id','status','created_at'
        ])
        && request.resource.data.parent_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() >= 3
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1
        && request.resource.data.grade <= 11
        && request.resource.data.school_id is int
        && request.resource.data.class_letter is string;
      allow update: if admin() || (
        activeParent()
        && resource.data.parent_id == request.auth.uid
        && request.resource.data.parent_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['full_name','grade','class_letter','school_id','status'])
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1 && request.resource.data.grade <= 11
        && request.resource.data.full_name is string
      );
      allow delete: if admin();
    }

    // Stage 1: approved teacher's own classrooms. Student membership is NEVER
    // derived from freely chosen school IDs; only verified teacher profiles pass.
    function activeTeacher() {
      return myProfileExists() &&
        (myProfile().role == 'teacher' || admin()) &&
        myProfile().status == 'approved' &&
        request.auth.token.email_verified == true;
    }
    function ownsClassroom(data) {
      return activeTeacher() && data.owner_uid == request.auth.uid;
    }
    function studentActive() {
      return myProfileExists() &&
        myProfile().role == 'student' &&
        myProfile().status != 'rejected' &&
        request.auth.token.email_verified == true;
    }
    function classPath(classId) {
      return /databases/$(database)/documents/classrooms/$(classId);
    }
    function memberPath(classId,uid) {
      return /databases/$(database)/documents/class_memberships/$(classId + '_' + uid);
    }
    function teacherOwnsClass(classId) {
      return activeTeacher() && exists(classPath(classId)) &&
        get(classPath(classId)).data.owner_uid == request.auth.uid;
    }
    function isClassMember(classId) {
      return studentActive() &&
        exists(memberPath(classId,request.auth.uid)) &&
        get(memberPath(classId,request.auth.uid)).data.status == 'approved';
    }
    match /class_memberships/{membershipId} {
      allow get, list: if admin() || (
        signedIn() && (resource.data.student_uid == request.auth.uid ||
          (activeTeacher() && resource.data.owner_uid == request.auth.uid))
      );
      allow create: if studentActive()
        && request.resource.data.keys().hasOnly([
          'class_id','owner_uid','student_uid','student_name','class_name','status','created_at'
        ])
        && request.resource.data.keys().hasAll([
          'class_id','owner_uid','student_uid','student_name','class_name','status','created_at'
        ])
        && request.resource.data.class_id is string
        && request.resource.data.class_id.matches('^[A-Za-z0-9]{20}$')
        && membershipId == request.resource.data.class_id + '_' + request.auth.uid
        && request.resource.data.student_uid == request.auth.uid
        && request.resource.data.student_name == myProfile().full_name
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is int
        && exists(classPath(request.resource.data.class_id))
        && request.resource.data.owner_uid ==
          get(classPath(request.resource.data.class_id)).data.owner_uid
        && request.resource.data.class_name ==
          get(classPath(request.resource.data.class_id)).data.name;
      allow update: if admin() || (
        activeTeacher()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved','rejected']
      );
      allow delete: if admin() || (
        signedIn() && (resource.data.student_uid == request.auth.uid ||
          (activeTeacher() && resource.data.owner_uid == request.auth.uid))
      );
    }
    match /classrooms/{classId} {
      allow get: if admin() || ownsClassroom(resource.data) || studentActive();
      allow list: if admin() || ownsClassroom(resource.data);
      allow create: if activeTeacher()
        && request.resource.data.keys().hasOnly(['owner_uid','school_id','name','grade','letter','created_at'])
        && request.resource.data.keys().hasAll(['owner_uid','school_id','name','grade','letter','created_at'])
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.school_id == myProfile().school_id
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.grade is int
        && request.resource.data.grade >= 1 && request.resource.data.grade <= 11
        && request.resource.data.letter is string
        && request.resource.data.letter.size() <= 4
        && request.resource.data.created_at is int;
      allow update, delete: if admin() || (
        ownsClassroom(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','grade','letter'])
      );
      match /active_quiz/{alertId} {
        allow get: if alertId == 'current' &&
          (admin() || teacherOwnsClass(classId) || isClassMember(classId));
        allow list: if false;
        allow create, update: if alertId == 'current'
          && teacherOwnsClass(classId)
          && request.resource.data.owner_uid == request.auth.uid
          && request.resource.data.class_id == classId
          && (
            (
              request.resource.data.keys().hasOnly([
                'owner_uid','class_id','quiz_id','title','status','started_at'
              ])
              && request.resource.data.keys().hasAll([
                'owner_uid','class_id','quiz_id','title','status','started_at'
              ])
              && request.resource.data.quiz_id is string
              && request.resource.data.title is string
              && request.resource.data.status == 'open'
              && request.resource.data.started_at is int
              && getAfter(quizPath(request.resource.data.quiz_id)).data.owner_uid == request.auth.uid
              && getAfter(quizPath(request.resource.data.quiz_id)).data.class_id == classId
              && getAfter(quizPath(request.resource.data.quiz_id)).data.status == 'open'
            )
            || (
              resource != null
              && resource.data.owner_uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'closed'
            )
          );
        allow delete: if admin() || teacherOwnsClass(classId);
      }
    }

    // Stage 2: quiz is not a formal grade or identity verification service.
    // The random document ID is the join code. No public collection listing.
    function quizPath(id) { return /databases/$(database)/documents/quizzes/$(id); }
    function isQuizOwner(id) {
      return activeTeacher() &&
        get(quizPath(id)).data.owner_uid == request.auth.uid;
    }
    function quizOpen(id) {
      return exists(quizPath(id)) && get(quizPath(id)).data.status == 'open';
    }
    match /quizzes/{quizId} {
      // Public legacy QR quizzes still support anonymous accounts.
      // Class-linked quizzes are private until the teacher starts them.
      allow get: if admin()
        || (activeTeacher() && resource.data.owner_uid == request.auth.uid)
        || (signedIn() && !resource.data.keys().hasAny(['class_id']))
        || (resource.data.keys().hasAny(['class_id'])
            && resource.data.status == 'open'
            && isClassMember(resource.data.class_id));
      allow list: if admin() ||
        (activeTeacher() && resource.data.owner_uid == request.auth.uid);
      allow create: if activeTeacher()
        && request.resource.data.keys().hasOnly([
          'owner_uid','school_id','title','questions','status','created_at','class_id'
        ])
        && request.resource.data.keys().hasAll([
          'owner_uid','school_id','title','questions','status','created_at'
        ])
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.school_id == myProfile().school_id
        && (
          (!request.resource.data.keys().hasAny(['class_id'])
            && request.resource.data.status == 'open')
          || (request.resource.data.keys().hasAny(['class_id'])
            && request.resource.data.status == 'draft'
            && teacherOwnsClass(request.resource.data.class_id))
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.questions is list
        && request.resource.data.questions.size() >= 1
        && request.resource.data.questions.size() <= 10
        && request.resource.data.created_at is int;
      allow update: if admin() || (
        activeTeacher()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','closed_at','started_at'])
        && (
          (resource.data.status == 'draft'
            && resource.data.keys().hasAny(['class_id'])
            && request.resource.data.status == 'open'
            && request.resource.data.started_at is int
            && teacherOwnsClass(resource.data.class_id))
          || (resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && request.resource.data.closed_at is int)
        )
      );
      allow delete: if admin();

      match /responses/{answerId} {
        allow get: if admin() ||
          isQuizOwner(quizId) ||
          (signedIn() && resource.data.participant_uid == request.auth.uid);
        allow list: if admin() || isQuizOwner(quizId);
        allow create: if signedIn() && quizOpen(quizId)
          && (
            !get(quizPath(quizId)).data.keys().hasAny(['class_id'])
            || isClassMember(get(quizPath(quizId)).data.class_id)
          )
          && request.resource.data.keys().hasOnly([
            'participant_uid','question_index','option_index','alias','created_at'
          ])
          && request.resource.data.keys().hasAll([
            'participant_uid','question_index','option_index','alias','created_at'
          ])
          && request.resource.data.participant_uid == request.auth.uid
          && request.resource.data.question_index is int
          && request.resource.data.question_index >= 0
          && request.resource.data.question_index <
            get(quizPath(quizId)).data.questions.size()
          && request.resource.data.option_index is int
          && request.resource.data.option_index >= 0
          && request.resource.data.option_index <= 3
          && request.resource.data.alias is string
          && request.resource.data.alias.size() >= 1
          && request.resource.data.alias.size() <= 24
          && request.resource.data.created_at is int
          && answerId == request.auth.uid + '_' + string(request.resource.data.question_index);
        // A participant cannot change a response once submitted.
        allow update, delete: if false;
      }
    }
    match /quiz_answer_keys/{quizId} {
      allow get, list: if admin() || isQuizOwner(quizId);
      // A single atomic batch creates the public quiz and private answer keys.
      allow create: if activeTeacher()
        && request.resource.data.keys().hasOnly(['owner_uid','answers','created_at'])
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.answers is list
        && request.resource.data.answers.size() >= 1
        && request.resource.data.answers.size() <= 10
        && getAfter(quizPath(quizId)).data.owner_uid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /{path=**} { allow read, write: if false; }
  }
}
